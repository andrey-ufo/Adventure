<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:maxHeight="520dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tv_debug_scene_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Текущая сцена: —"
            android:textSize="12sp"
            android:textColor="#9E9E9E"
            android:layout_marginBottom="12dp" />

        <!-- ===== Статы ===== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Статы"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="6dp" />

        <LinearLayout
            android:id="@+id/container_stats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="6dp" />

        <Button
            android:id="@+id/btn_add_stat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+ Стат"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            style="?android:attr/borderlessButtonStyle"
            android:layout_marginBottom="16dp" />

        <!-- ===== Флаги ===== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Флаги"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="6dp" />

        <LinearLayout
            android:id="@+id/container_flags"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="6dp" />

        <Button
            android:id="@+id/btn_add_flag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+ Флаг"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            style="?android:attr/borderlessButtonStyle"
            android:layout_marginBottom="16dp" />

        <!-- ===== Сброс ===== -->
        <Button
            android:id="@+id/btn_reset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Сбросить к начальному состоянию"
            android:textColor="#FF9800"
            android:textSize="13sp"
            style="?android:attr/borderlessButtonStyle" />

    </LinearLayout>
</ScrollView>