<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:maxHeight="560dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/template_edit_id_label"
            android:textSize="11sp"
            android:textColor="#AAAAAA"
            android:layout_marginBottom="2dp" />

        <EditText
            android:id="@+id/et_template_id"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="use_item"
            android:inputType="text"
            android:autofillHints=""
            android:fontFamily="monospace"
            android:textColor="#FFFFFF"
            android:textColorHint="#AAAAAA"
            android:maxLines="1" />

        <TextView
            android:id="@+id/tv_template_id_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/template_id_hint_default"
            android:textSize="11sp"
            android:textColor="#9E9E9E"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/template_edit_text_label"
            android:textSize="11sp"
            android:textColor="#AAAAAA"
            android:layout_marginBottom="2dp" />

        <EditText
            android:id="@+id/et_template_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/template_edit_text_hint"
            android:inputType="text"
            android:autofillHints=""
            android:textColor="#FFFFFF"
            android:textColorHint="#AAAAAA" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/template_edit_text_desc"
            android:textSize="11sp"
            android:textColor="#9E9E9E"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/template_edit_visibility_label"
            android:textSize="11sp"
            android:textColor="#AAAAAA"
            android:layout_marginBottom="2dp" />

        <EditText
            android:id="@+id/et_template_visibility_condition"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="itemId > 0"
            android:inputType="text"
            android:autofillHints=""
            android:textColor="#FFFFFF"
            android:textColorHint="#AAAAAA"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/template_edit_availability_label"
            android:textSize="11sp"
            android:textColor="#AAAAAA"
            android:layout_marginBottom="2dp" />

        <EditText
            android:id="@+id/et_template_availability_condition"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="itemId > 0"
            android:inputType="text"
            android:autofillHints=""
            android:textColor="#FFFFFF"
            android:textColorHint="#AAAAAA"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/template_edit_next_scene_label"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/tv_template_next_scene"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/template_next_scene_unset"
                android:textColor="#FF9800"
                android:textSize="13sp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp" />

            <Button
                android:id="@+id/btn_pick_next_scene"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✎"
                android:textColor="#FFFFFF"
                style="?android:attr/borderlessButtonStyle"
                android:textSize="14sp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/template_edit_params_label"
            android:textColor="#AAAAAA"
            android:textSize="12sp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp" />

        <LinearLayout
            android:id="@+id/container_template_params"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="4dp" />

        <Button
            android:id="@+id/btn_add_template_param"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/template_edit_add_param"
            android:textColor="#FFFFFF"
            style="?android:attr/borderlessButtonStyle"
            android:textSize="12sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/template_edit_effects_label"
            android:textColor="#AAAAAA"
            android:textSize="12sp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp" />

        <LinearLayout
            android:id="@+id/container_template_effects"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="4dp" />

        <Button
            android:id="@+id/btn_add_template_effect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dialog_edit_choice_tags_add_effect"
            android:textColor="#FFFFFF"
            style="?android:attr/borderlessButtonStyle"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>