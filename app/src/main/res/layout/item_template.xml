<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp"
    android:layout_marginBottom="8dp"
    android:background="@drawable/scene_background"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_template_id"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:textColor="#9E9E9E"
            android:maxLines="1"
            android:ellipsize="end" />

        <Button
            android:id="@+id/btn_template_delete"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/item_template_delete_button"
            android:textColor="#FF4444"
            style="?android:attr/borderlessButtonStyle"
            android:textSize="14sp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_template_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="15sp"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:layout_marginTop="2dp"
        android:maxLines="2"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/tv_template_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:textColor="#AAAAAA"
        android:layout_marginTop="4dp" />
</LinearLayout>