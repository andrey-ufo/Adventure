<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Заголовок с кнопкой "Меню" (закреплён) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/btn_menu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Меню"
            android:textColor="#FFFFFF"
            style="?android:attr/borderlessButtonStyle" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Редактор приключения"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:gravity="center" />
    </LinearLayout>

    <!-- Прокручиваемая область -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Кнопка загрузки -->
            <Button
                android:id="@+id/btn_load"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Загрузить приключение из файла"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="12dp" />

            <!-- Название -->
            <EditText
                android:id="@+id/et_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Название приключения"
                android:textColor="#FFFFFF"
                android:textColorHint="#BBBBBB"
                android:textSize="16sp"
                android:layout_marginBottom="8dp" />

            <!-- Автор -->
            <EditText
                android:id="@+id/et_author"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Автор"
                android:textColor="#FFFFFF"
                android:textColorHint="#BBBBBB"
                android:textSize="16sp"
                android:layout_marginBottom="8dp" />

            <!-- Описание -->
            <EditText
                android:id="@+id/et_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Описание"
                android:textColor="#FFFFFF"
                android:textColorHint="#BBBBBB"
                android:minLines="2"
                android:gravity="top"
                android:textSize="14sp"
                android:layout_marginBottom="12dp" />

            <!-- Список сцен -->
            <LinearLayout
                android:id="@+id/scenes_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- Кнопка добавления сцены -->
            <Button
                android:id="@+id/btn_add_scene"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Добавить сцену"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="8dp" />

            <!-- Кнопка сохранения (с отступом снизу) -->
            <Button
                android:id="@+id/btn_save"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Сохранить приключение"
                android:textColor="#FFFFFF"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="32dp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>