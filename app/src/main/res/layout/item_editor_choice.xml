<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginBottom="8dp"
    android:padding="4dp"
    android:background="@drawable/scene_background">

    <!-- Строка с текстом варианта и кнопкой удаления -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/et_choice_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Текст варианта"
            android:textColor="#FFFFFF"
            android:textColorHint="#AAAAAA"
            android:background="@android:color/transparent" />

        <Button
            android:id="@+id/btn_delete_choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✕"
            android:textColor="#FF4444"
            style="?android:attr/borderlessButtonStyle"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="След. сцена:"
            android:textColor="#FFFFFF" />

        <Spinner
            android:id="@+id/spinner_next_scene"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />
    </LinearLayout>

    <EditText
        android:id="@+id/et_choice_condition"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Условие (метка)"
        android:textColor="#FFFFFF"
        android:textColorHint="#AAAAAA"
        android:background="@android:color/transparent" />
</LinearLayout>