<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

    <TextView
        android:id="@+id/tv_settings_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/settings_title"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="24dp" />

    <!-- Permissions -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_permissions_title"
            android:textAppearance="?attr/textAppearanceSubtitle1"
            android:layout_marginTop="16dp" />

        <Button
            android:id="@+id/btn_enable_notifications"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_enable_notifications"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/btn_enable_activity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_enable_activity"
            android:layout_marginTop="8dp" />

        <CheckBox
            android:id="@+id/cb_health_connect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_health_connect"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tv_health_connect_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="12sp"
            android:textColor="#9E9E9E"
            android:layout_marginBottom="24dp"
            android:visibility="gone" />

    <!-- Темы -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/settings_theme_title"
        android:textAppearance="?attr/textAppearanceSubtitle1"
        android:layout_marginTop="16dp" />

    <RadioGroup
        android:id="@+id/rg_theme"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RadioButton
            android:id="@+id/rb_theme_system"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_theme_system" />

        <RadioButton
            android:id="@+id/rb_theme_light"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_theme_light" />

        <RadioButton
            android:id="@+id/rb_theme_dark"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_theme_dark" />
    </RadioGroup>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?android:attr/listDivider"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp" />

    <!-- Размер шрифта -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/settings_font_size_label"
        android:textSize="16sp"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="8dp" />

    <Spinner
        android:id="@+id/spinner_font_size"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp" />

    <!-- Выбор шрифта -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/settings_font_label"
        android:textSize="16sp"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <Spinner
            android:id="@+id/spinner_font"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <Button
            android:id="@+id/btn_add_font"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_add_font"
            android:textColor="#FFFFFF"
            style="?android:attr/borderlessButtonStyle" />
    </LinearLayout>

    <!-- Пример текста с выбранным шрифтом -->
    <TextView
        android:id="@+id/tv_font_sample"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/settings_font_sample"
        android:textSize="20sp"
        android:textColor="#FFFFFF"
        android:gravity="center"
        android:layout_marginTop="16dp"
        android:padding="12dp"
        android:background="@drawable/scene_background" />

        <!-- Логирование -->
        <CheckBox
            android:id="@+id/cb_logging"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_logging"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="16dp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>