<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="8dp"
    android:background="@drawable/scene_background"
    android:layout_marginBottom="12dp">

    <!-- ===== Шапка: шеврон, заголовок, удалить ===== -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_chevron"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:text="▼"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <EditText
            android:id="@+id/et_scene_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Название сцены"
            android:textColor="#FFFFFF"
            android:textColorHint="#AAAAAA"
            android:textSize="15sp"
            android:textStyle="bold"
            android:background="@android:color/transparent"
            android:maxLines="1" />

        <Button
            android:id="@+id/btn_delete_scene"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✕"
            android:textColor="#FF4444"
            style="?android:attr/borderlessButtonStyle"
            android:textSize="16sp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp" />
    </LinearLayout>

    <!-- ===== Инфо-строка: ID, счётчик вариантов, бейдж главы ===== -->
    <LinearLayout
        android:id="@+id/info_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="32dp"
        android:paddingEnd="8dp"
        android:layout_marginBottom="4dp"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackground">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_scene_id"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="ID: "
                android:textColor="#9E9E9E"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="end" />

            <ImageButton
                android:id="@+id/btn_rebuild_id"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_rotate"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Пересобрать ID из названия"
                android:scaleType="centerInside"
                android:padding="2dp"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/btn_preview_scene"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_media_play"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Предпросмотр сцены в читалке"
                android:scaleType="centerInside"
                android:padding="2dp" />

        </LinearLayout>

        <TextView
            android:id="@+id/tv_choices_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#9E9E9E"
            android:textSize="11sp"
            android:layout_marginStart="8dp" />

        <TextView
            android:id="@+id/tv_chapter_end_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🏁 Глава"
            android:textSize="11sp"
            android:textColor="#FFC107"
            android:layout_marginStart="8dp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- ===== Тело: скрывается при сворачивании ===== -->
    <LinearLayout
        android:id="@+id/body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="4dp">

        <EditText
            android:id="@+id/et_scene_text"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:hint="Текст сцены"
            android:textColor="#FFFFFF"
            android:textColorHint="#AAAAAA"
            android:gravity="top"
            android:textSize="14sp"
            android:layout_marginBottom="8dp"
            android:background="@android:color/transparent" />

        <LinearLayout
            android:id="@+id/container_tags"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="4dp" />

        <Button
            android:id="@+id/btn_add_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Добавить метку"
            android:textColor="#FFFFFF"
            style="?android:attr/borderlessButtonStyle"
            android:textSize="12sp" />

        <CheckBox
            android:id="@+id/cb_chapter_end"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Сделать концом главы"
            android:textColor="#FFFFFF"
            android:layout_marginTop="8dp" />

        <LinearLayout
            android:id="@+id/layout_steps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone"
            android:layout_marginBottom="8dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground"
            android:padding="6dp">

            <TextView
                android:id="@+id/tv_steps_display"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="13sp"
                android:textColor="#FFC107" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/container_choices"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="4dp" />

        <Button
            android:id="@+id/btn_add_choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Добавить вариант действия"
            android:textColor="#FFFFFF"
            style="?android:attr/borderlessButtonStyle"
            android:textSize="12sp" />

    </LinearLayout>

</LinearLayout>