<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="8dp"
    android:background="@drawable/scene_background"
    android:layout_marginBottom="12dp">

    <!-- Заголовок сцены и кнопка удаления в одной строке -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/et_scene_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Название сцены"
            android:textColor="#FFFFFF"
            android:textColorHint="#AAAAAA"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@android:color/transparent" />

        <Button
            android:id="@+id/btn_delete_scene"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✕"
            android:textColor="#FF4444"
            style="?android:attr/borderlessButtonStyle"
            android:textSize="16sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_scene_id"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ID: "
        android:textColor="#BBBBBB"
        android:textSize="12sp"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/et_scene_text"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:hint="Текст сцены"
        android:textColor="#FFFFFF"
        android:textColorHint="#AAAAAA"
        android:gravity="top"
        android:textSize="14sp"
        android:layout_marginBottom="8dp"
        android:background="@android:color/transparent" />

    <LinearLayout
        android:id="@+id/container_tags"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="4dp" />

    <Button
        android:id="@+id/btn_add_tag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Добавить метку"
        android:textColor="#FFFFFF"
        style="?android:attr/borderlessButtonStyle"
        android:textSize="12sp" />

    <CheckBox
        android:id="@+id/cb_chapter_end"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Сделать концом главы"
        android:textColor="#FFFFFF"
        android:layout_marginTop="8dp" />

    <LinearLayout
        android:id="@+id/layout_steps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Шагов до след. главы:"
            android:textColor="#FFFFFF"
            android:layout_gravity="center_vertical" />

        <EditText
            android:id="@+id/et_steps"
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:text="0"
            android:textColor="#FFFFFF"
            android:textColorHint="#AAAAAA"
            android:background="@android:color/transparent" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/container_choices"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="4dp" />

    <Button
        android:id="@+id/btn_add_choice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Добавить вариант действия"
        android:textColor="#FFFFFF"
        style="?android:attr/borderlessButtonStyle"
        android:textSize="12sp" />

</LinearLayout>