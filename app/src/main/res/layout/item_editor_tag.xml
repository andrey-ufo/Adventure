<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginBottom="6dp"
    android:padding="6dp"
    android:background="@drawable/scene_background">

    <!-- Row 1: tag name, value, delete -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/et_tag_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/item_editor_tag_name_hint"
            android:textColor="#FFFFFF"
            android:textColorHint="#AAAAAA"
            android:textSize="13sp"
            android:background="@android:color/transparent" />

        <EditText
            android:id="@+id/et_tag_value"
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:hint="@string/item_editor_tag_value_hint"
            android:inputType="numberSigned"
            android:textColor="#FFFFFF"
            android:textColorHint="#AAAAAA"
            android:textSize="13sp"
            android:background="@android:color/transparent" />

        <Button
            android:id="@+id/btn_delete_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/icon_close"
            android:textColor="#FF4444"
            style="?android:attr/borderlessButtonStyle"
            android:textSize="14sp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp" />
    </LinearLayout>

    <!-- Row 2: display name, category, visible -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="2dp">

        <EditText
            android:id="@+id/et_tag_display"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/item_editor_tag_display_name_hint"
            android:textColor="#FFFFFF"
            android:textColorHint="#AAAAAA"
            android:textSize="12sp"
            android:background="@android:color/transparent" />

        <Spinner
            android:id="@+id/spinner_tag_category"
            android:layout_width="110dp"
            android:layout_height="wrap_content" />

        <CheckBox
            android:id="@+id/cb_tag_visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/icon_eye"
            android:textSize="14sp"
            android:contentDescription="@string/item_editor_tag_visible_content_description" />
    </LinearLayout>
</LinearLayout>