<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/dialog_chapter_steps_title"
        android:textSize="14sp"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/dialog_chapter_steps_average_hint"
        android:textSize="11sp"
        android:textColor="#9E9E9E"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btn_steps_500"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/dialog_chapter_steps_preset_500"
        android:textColor="#FFFFFF"
        android:gravity="start|center_vertical"
        style="?android:attr/borderlessButtonStyle" />

    <Button
        android:id="@+id/btn_steps_1000"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/dialog_chapter_steps_preset_1000"
        android:textColor="#FFFFFF"
        android:gravity="start|center_vertical"
        style="?android:attr/borderlessButtonStyle" />

    <Button
        android:id="@+id/btn_steps_4000"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/dialog_chapter_steps_preset_4000"
        android:textColor="#FFFFFF"
        android:gravity="start|center_vertical"
        style="?android:attr/borderlessButtonStyle" />

    <Button
        android:id="@+id/btn_steps_8000"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/dialog_chapter_steps_preset_8000"
        android:textColor="#FFFFFF"
        android:gravity="start|center_vertical"
        style="?android:attr/borderlessButtonStyle" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#444444"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/dialog_chapter_steps_custom_label"
        android:textSize="13sp"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/et_custom_steps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/dialog_chapter_steps_custom_hint"
        android:inputType="number"
        android:autofillHints="" />

    <CheckBox
        android:id="@+id/cb_repeatable"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/dialog_chapter_steps_repeatable"
        android:textColor="#FFFFFF" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/dialog_chapter_steps_repeatable_hint"
        android:textSize="11sp"
        android:textColor="#9E9E9E" />

</LinearLayout>