    <!--
    All user-facing UI strings live in this file.
    See docs/i18n-policy.md for conventions and scope.

    Grouped by functional area, so adding a new string
    has one obvious home. Prefixes:
      app_         — application-wide
      menu_        — main menu
      library_     — adventure list
      editor_      — editor toolbar / save status / dialogs / toasts
      editor_scene_ / editor_choice_ / editor_tag_ / editor_steps_ /
      editor_chapter_ / editor_stats_ / editor_search_
      template_    — template list and edit dialog
      reader_      — reader (HUD, menu, dialogs, permissions, end, death, gate, warnings)
      stats_       — statistics
      settings_    — settings
      setup_       — first-run setup
      logs_        — log viewer
      search_      — search dialog (shared)
      validation_  — validation dialog
      import_      — import helper
      step_service_— foreground service notification
      var_kind_    — VarKind display names
      variables_header_ / variable_name_hint
      scene_picker_/ scene_no_id
      map_         — adventure map
      label_       — generic placeholders ("(без названия)", "(пусто)")
      dialog_      — shared dialog buttons + specific dialogs
      action_      — shared action buttons outside dialogs
      icon_        — shared icon glyphs
      item_        — list item layouts
      word_        — plural helpers
    -->
